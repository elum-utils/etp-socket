{
  "type": "module",
  "scripts": {
    "build:socket": "vite build --config config/vite.socket.config.ts",
    "tsc:socket": "rollup --config config/rollup.socket.config.ts",
    "build": "npm run build:socket && npm run tsc:socket",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:go": "bash integration/run-conformance.sh"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.2.7",
    "rollup": "^4.34.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.1.1",
    "terser": "^5.37.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.2.4"
  }
}
